{
  "permissions": {
    "allow": [
      "Bash(uv tool install graphifyy)",
      "Bash(graphify *)",
      "Bash(brew search *)",
      "Bash(brew list *)",
      "Bash(brew info *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "google-colab": "off",
    "animation-quality-gate": "off",
    "atlas-uv-fitting": "off",
    "blender-animation": "off",
    "blender-cameras": "off",
    "blender-export": "off",
    "blender-lighting": "off",
    "blender-materials": "off",
    "blender-modeling": "off",
    "blender-pro-workflow": "off",
    "blender-rendering": "off",
    "blender-skill-harmonizer": "off",
    "blender-uv-texturing": "off",
    "brandkit": "off",
    "canvas-design": "off",
    "closed-surface-uv-coverage": "off",
    "contour-to-mesh": "off",
    "embedded-captions": "off",
    "faceless-explainer": "off",
    "figma": "off",
    "fit-repair-optimizer": "off",
    "frontend-design": "off",
    "general-video": "off",
    "high-end-visual-design": "off",
    "hyperframes-animation": "off",
    "hyperframes-audio": "off",
    "hyperframes-cli": "off",
    "hyperframes-core": "off",
    "hyperframes-creative": "off",
    "hyperframes-keyframes": "<REDIGIDO>",
    "hyperframes-registry": "off",
    "hyperframes-studio": "off",
    "hyperframes": "off",
    "landmark-fit-repair": "off",
    "mascot-logo-reconstruction": "off",
    "media-use": "off",
    "motion-graphics": "off",
    "multiview-constraint-solver": "off",
    "multiview-fit-loop": "off",
    "music-to-video": "off",
    "orbital-hud-motion": "off",
    "orthographic-registration": "off",
    "pr-to-video": "off",
    "product-launch-video": "off",
    "quality-refinement-autoloop": "off",
    "reference-analysis-validator": "off",
    "reference-look-calibration": "off",
    "reference-to-3d": "off",
    "remotion-best-practices": "off",
    "remotion-captions": "off",
    "remotion-create": "off",
    "remotion-docs": "off",
    "remotion-interactivity": "off",
    "remotion-maps": "off",
    "remotion-markup": "off",
    "remotion-multimedia": "off",
    "remotion-render": "off",
    "remotion-saas": "off",
    "remotion-studio": "off",
    "remotion-to-hyperframes": "off",
    "remotion-upgrade": "off",
    "slideshow": "off",
    "source-part-segmentation": "off",
    "talking-head-recut": "off",
    "text-to-blender": "off",
    "texture-driven-mesh-fitting": "off",
    "texture-state-animation": "off",
    "threejs-animation": "off",
    "threejs-fundamentals": "off",
    "threejs-geometry": "off",
    "threejs-interaction": "off",
    "threejs-lighting": "off",
    "threejs-loaders": "off",
    "threejs-materials": "off",
    "threejs-postprocessing": "off",
    "threejs-shaders": "off",
    "threejs-textures": "off",
    "to-wireframe": "off",
    "ui-ux-pro-max": "off",
    "video-editing": "off",
    "wireframe-to-3d": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$LOCALAPPDATA/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=\"$HOME/AppData/Local/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$HOME/.claude/hooks/revisar-trabalho-ollama.py\"",
            "timeout": 15,
            "statusMessage": "Verificando pendencia de revisao do Ollama"
          },
          {
            "type": "command",
            "command": "PY=\"$LOCALAPPDATA/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=\"$HOME/AppData/Local/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$HOME/.claude/hooks/segundo-cerebro.py\" anunciar",
            "timeout": 10,
            "statusMessage": "Ativando Segundo Cerebro"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$LOCALAPPDATA/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=\"$HOME/AppData/Local/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$HOME/.claude/hooks/segundo-cerebro.py\" consultar",
            "timeout": 30,
            "statusMessage": "Consultando o Segundo Cerebro"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$LOCALAPPDATA/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=\"$HOME/AppData/Local/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$HOME/.claude/hooks/segundo-cerebro.py\" guardar",
            "timeout": 20,
            "statusMessage": "Auditando sigilo da escrita"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$LOCALAPPDATA/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=\"$HOME/AppData/Local/Programs/Python/Python312/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$HOME/.claude/hooks/segundo-cerebro.py\" registrar",
            "timeout": 30,
            "statusMessage": "Registrando aprendizado no Segundo Cerebro"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "token-router@<USER>-plugins": true,
    "claude-security@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "cli-anything@cli-anything": false,
    "codex@openai-codex": false,
    "ponytail@ponytail": false,
    "ralph-loop@claude-plugins-official": false,
    "coderabbit@claude-plugins-official": false,
    "dak@data-agent-kit-starter-pack-marketplace": false,
    "claude-code-setup@claude-plugins-official": true,
    "cartographer@cartographer-marketplace": true
  },
  "extraKnownMarketplaces": {
    "<USER>-plugins": {
      "source": {
        "source": "github",
        "repo": "<USER_NAME>/claude-token-router"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "hkuds/cli-anything"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "data-agent-kit-starter-pack-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack.git"
      }
    },
    "cartographer-marketplace": {
      "source": {
        "source": "github",
        "repo": "kingbootoshi/cartographer"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "low",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Primary use of Claude Code**: software development",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: None configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet; if it runs inside a container/VM/pod with an egress allow-list, no network, or neighbours it must not touch, say so here",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured) — as scoped by the Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — includes the DFIR case data referenced in ~/.claude/CLAUDE.md (e.g. ~/Casos/<caso>/, C:\\Casos\\<caso>\\, the acervo-conhecimento private knowledge repo) and any credential-shaped file (.credentials.json, .env, .pem, id_rsa)",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (no project-specific override found; this working directory C:\\ has no tracked files or remotes)",
      "**Trusted repo**: No git repository detected in this working directory (C:\\ has 0 tracked files, no remotes, default branch unset) — no trusted repo can be scoped here; treat any git operations as unverified until a real project checkout is confirmed",
      "**Org-specific CLIs**: None configured",
      "**routine under <user>/ prefix**: none identified"
    ]
  }
}
