{
  "context7": {
    "command": "cmd.exe",
    "args": [
      "/c",
      "npx",
      "-y",
      "@upstash/context7-mcp"
    ]
  },
  "github": {
    "command": "cmd.exe",
    "args": [
      "/c",
      "npx",
      "-y",
      "@modelcontextprotocol/server-github"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "<REDIGIDO>"
    }
  },
  "filesystem": {
    "command": "cmd.exe",
    "args": [
      "/c",
      "npx",
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "C:\\\\Users\\\\<USER>",
      "C:\\\\ACERVO",
      "C:\\\\"
    ]
  },
  "sequential-thinking": {
    "command": "cmd.exe",
    "args": [
      "/c",
      "npx",
      "-y",
      "@modelcontextprotocol/server-sequential-thinking"
    ]
  },
  "playwright": {
    "command": "cmd.exe",
    "args": [
      "/c",
      "npx",
      "-y",
      "@playwright/mcp@latest"
    ]
  }
}
